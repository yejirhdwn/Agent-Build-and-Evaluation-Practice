# --- 모델 (필수) ---
# 기본 모델은 OpenRouter 의 moonshotai/kimi-k3 다. 변수 이름은 OPENAI_API_KEY 지만
# OpenAI 키가 아니라 OpenRouter 키(sk-or-...)를 넣는다(OpenRouter 는 OpenAI 호환 API).
# OpenAI 를 직접 쓰려면 MODEL_BASE_URL/MODEL_NAME 을 OpenAI 값으로 바꾸고 OpenAI 키를 넣는다.
OPENAI_API_KEY=
MODEL_NAME=moonshotai/kimi-k3
MODEL_BASE_URL=https://openrouter.ai/api/v1

# --- LangSmith Observation (권장) ---
# 키가 비어 있으면 경고만 출력하고 트레이싱 없이 실행한다. 프로젝트는 첫 trace 가 들어올 때 자동 생성된다.
# EU 리전은 LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com 으로 바꾼다.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=log-trace-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- LLM Judge (선택) ---
# 비우면 에이전트 모델(MODEL_NAME)을 temperature 0 으로 쓴다. 가능하면 에이전트와 다른 모델을 지정한다
# (예: anthropic/claude-sonnet-5.5). OpenRouter 워크스페이스 guardrail 에서 허용된 모델이어야 한다.
# 키·base URL 을 비우면 OPENAI_API_KEY·MODEL_BASE_URL 을 그대로 쓴다.
JUDGE_MODEL_NAME=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# --- 비용 지표 (선택) ---
# 비우면 OpenRouter 모델 가격표에서 단가를 조회한다. 직접 지정하려면 100만 토큰당 USD 를 넣는다.
MODEL_PRICE_INPUT_PER_M=
MODEL_PRICE_OUTPUT_PER_M=

# --- 웹 검색 커넥터 (선택) ---
# 있으면 Tavily 웹 검색 도구가 자동 활성화된다.
TAVILY_API_KEY=

# --- Slack 커넥터 (선택) ---
# 쓰기용 Bot User OAuth Token (xoxb-...). Bot Token Scope: chat:write
SLACK_BOT_TOKEN=
# 읽기용 User OAuth Token (xoxp-...). 봇 초대 없이 내가 속한 (비)공개 채널 열람.
# User Token Scope: channels:history, groups:history, channels:read, groups:read
# 한쪽만 넣으면 그 토큰으로 읽기·쓰기를 모두 처리한다.
SLACK_USER_TOKEN=
# (게이트웨이 수신용) App-Level Token (xapp-...). Socket Mode 활성화 + scope connections:write.
# 이벤트 구독: app_mention, message.im. Slack 에서 봇을 멘션/DM 하면 에이전트가 답한다.
SLACK_APP_TOKEN=

# --- Telegram 커넥터 (선택) ---
# @BotFather 로 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=
# 기본 수신 대상 chat_id (telegram_send_message 의 chat_id 를 비우면 이 값을 사용)
TELEGRAM_CHAT_ID=

# --- Email 커넥터 (선택, 일반 SMTP/IMAP) ---
# 에이전트 '도구'로만 동작(게이트웨이 자동응답 아님): read_recent_emails / send_email
# Gmail 예: SMTP smtp.gmail.com:587, IMAP imap.gmail.com:993, 앱 비밀번호 사용
# 발신 (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# 수신 (IMAP) — USER/PASSWORD 미설정 시 SMTP_USER/PASSWORD 를 재사용
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- 작업 공간 (선택) ---
# 에이전트 파일/셸 작업이 이뤄지는 디렉터리 
WORKSPACE_DIR=workspace

# --- 셸 허용 목록 (선택) ---
# 기본(미설정)은 에이전트 execute 셸에서 date 만 허용한다(정답 파일 유출 차단).
# 1 로 두면 meta-harness CLI(python skills/meta-harness/metaharness.py)도 허용한다.
# S1~S4 평가 중에는 켜지 않는다.
META_HARNESS_ENABLED=
